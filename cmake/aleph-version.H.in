/** @file aleph-version.H
 *  @brief Identity of the Aleph-w build that provides this header.
 *
 *  Generated by CMake from `cmake/aleph-version.H.in`; do not edit it. It
 *  records the release number, the revision of the sources and the options
 *  of the build that change the layout of the containers. The same values
 *  are published by `find_package(Aleph)` as `Aleph_VERSION`,
 *  `Aleph_SOURCE_REVISION`, `Aleph_SANITIZERS` and
 *  `Aleph_CONTAINER_ANNOTATIONS`, which `AlephConfig.cmake` reads from this
 *  very file.
 */

# ifndef ALEPH_VERSION_H
# define ALEPH_VERSION_H

/// Major number of the release.
# define ALEPH_VERSION_MAJOR @PROJECT_VERSION_MAJOR@

/// Minor number of the release.
# define ALEPH_VERSION_MINOR @PROJECT_VERSION_MINOR@

/// Patch number of the release.
# define ALEPH_VERSION_PATCH @PROJECT_VERSION_PATCH@

/// The release number, as in VERSION.txt.
# define ALEPH_VERSION_STRING "@PROJECT_VERSION@"

/// The release number as an integer that can be compared in `#if`.
# define ALEPH_VERSION_NUMBER \
  (ALEPH_VERSION_MAJOR * 1000000 + ALEPH_VERSION_MINOR * 1000 + ALEPH_VERSION_PATCH)

/** The revision of the sources: a commit hash, with `-dirty` appended when
    tracked files were modified, what the packager passed in
    `ALEPH_SOURCE_REVISION`, or `unknown`. Every commit between two releases
    carries the same release number; this tells them apart. */
# define ALEPH_SOURCE_REVISION "@ALEPH_RESOLVED_SOURCE_REVISION@"

/// 1 if the library was built with `ALEPH_USE_SANITIZERS` (ASan and UBSan).
# define ALEPH_BUILT_WITH_SANITIZERS @ALEPH_BUILT_WITH_SANITIZERS@

/** 1 if the library was built with the AddressSanitizer annotations of
    `MemArray` (`ALEPH_ANNOTATE_CONTAINERS`), which change its layout: every
    translation unit of the program must then be compiled the same way. */
# define ALEPH_BUILT_WITH_CONTAINER_ANNOTATIONS @ALEPH_BUILT_WITH_CONTAINER_ANNOTATIONS@

# if ALEPH_BUILT_WITH_CONTAINER_ANNOTATIONS
#  if defined(ALEPH_ANNOTATE_CONTAINERS) && defined(__SANITIZE_ADDRESS__)
#   define ALEPH_VERSION_TU_ANNOTATES_CONTAINERS 1
#  elif defined(ALEPH_ANNOTATE_CONTAINERS) && defined(__has_feature)
#   if __has_feature(address_sanitizer)
#    define ALEPH_VERSION_TU_ANNOTATES_CONTAINERS 1
#   endif
#  endif
#  ifndef ALEPH_VERSION_TU_ANNOTATES_CONTAINERS
#   error "This Aleph-w was built with AddressSanitizer container annotations, which change the layout of MemArray: link the Aleph::Aleph target, or compile with -fsanitize=address -DALEPH_ANNOTATE_CONTAINERS=1"
#  endif
#  undef ALEPH_VERSION_TU_ANNOTATES_CONTAINERS
# endif

namespace Aleph
{
  /** @brief Identity of the Aleph-w build that provides the headers.
   *
   *  The typed counterpart of the macros of aleph-version.H.
   *
   *  @ingroup Utilities
   */
  struct Build_Info
  {
    /// Major number of the release.
    static constexpr int version_major = ALEPH_VERSION_MAJOR;

    /// Minor number of the release.
    static constexpr int version_minor = ALEPH_VERSION_MINOR;

    /// Patch number of the release.
    static constexpr int version_patch = ALEPH_VERSION_PATCH;

    /// The release number, as in VERSION.txt.
    static constexpr const char * version = ALEPH_VERSION_STRING;

    /// The revision of the sources; see ALEPH_SOURCE_REVISION.
    static constexpr const char * source_revision = ALEPH_SOURCE_REVISION;

    /// `true` if the library was built with `ALEPH_USE_SANITIZERS`.
    static constexpr bool sanitizers = ALEPH_BUILT_WITH_SANITIZERS != 0;

    /// `true` if the library was built with the annotations of `MemArray`.
    static constexpr bool container_annotations =
      ALEPH_BUILT_WITH_CONTAINER_ANNOTATIONS != 0;
  };
} // namespace Aleph

# endif // ALEPH_VERSION_H
